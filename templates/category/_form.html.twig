{{ form_start(form) }}
    <div class="form-group">
        {{ form_label(form.title, 'Titre de la catégorie', {'attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.title, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Technologie, Voyage, Cuisine...'}}) }}
        {{ form_errors(form.title) }}
    </div>

    <div class="form-group">
        {{ form_label(form.description, 'Description', {'attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'placeholder': 'Décrivez brièvement cette catégorie...', 'rows': 4}}) }}
        {{ form_errors(form.description) }}
    </div>

    <div class="form-actions">
        <a href="{{ path('app_category_index') }}" class="btn btn-secondary">
            <i class="bi bi-x-circle"></i>
            Annuler
        </a>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-circle"></i>
            {{ button_label|default('Enregistrer') }}
        </button>
    </div>
{{ form_end(form) }}
