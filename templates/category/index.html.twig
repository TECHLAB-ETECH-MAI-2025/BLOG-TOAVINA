{% extends 'base.html.twig' %}

{% block title %}Gestion des Catégories{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #1877f2;
            --light-bg: #f0f2f5;
            --border-color: #dddfe2;
            --text-dark: #1c1e21;
            --text-light: #65676b;
            --card-bg: #ffffff;
            --shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
            --success-color: #42b883;
            --warning-color: #f39c12;
            --danger-color: #e74c3c;
        }
        
        body {
            background-color: var(--light-bg);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: var(--text-dark);
        }
        
        .header {
            background-color: var(--card-bg);
            border-bottom: 1px solid var(--border-color);
            padding: 12px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: var(--shadow);
        }
        
        .logo {
            font-size: 24px;
            font-weight: bold;
            color: var(--primary-color);
            text-decoration: none;
        }
        
        .create-btn-header {
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: 6px;
            padding: 8px 16px;
            font-weight: 600;
            text-decoration: none;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        
        .create-btn-header:hover {
            background-color: #166fe5;
            color: white;
        }
        
        .main-container {
            max-width: 900px;
            margin: 20px auto;
            padding: 0 16px;
        }
        
        .page-header {
            background-color: var(--card-bg);
            border-radius: 8px;
            box-shadow: var(--shadow);
            padding: 24px;
            margin-bottom: 20px;
            text-align: center;
        }
        
        .page-title {
            font-size: 28px;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 8px;
        }
        
        .page-subtitle {
            color: var(--text-light);
            font-size: 16px;
        }
        
        .stats-bar {
            background-color: var(--card-bg);
            border-radius: 8px;
            box-shadow: var(--shadow);
            padding: 16px 20px;
            margin-bottom: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        
        .stats-item {
            text-align: center;
        }
        
        .stats-number {
            font-size: 24px;
            font-weight: bold;
            color: var(--primary-color);
            display: block;
        }
        
        .stats-label {
            font-size: 12px;
            color: var(--text-light);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .category-card {
            background-color: var(--card-bg);
            border-radius: 8px;
            box-shadow: var(--shadow);
            margin-bottom: 16px;
            overflow: hidden;
            transition: box-shadow 0.2s ease;
        }
        
        .category-card:hover {
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        }
        
        .category-header {
            padding: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        
        .category-info {
            display: flex;
            align-items: center;
            flex: 1;
        }
        
        .category-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            background: linear-gradient(45deg, #667eea, #764ba2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            margin-right: 16px;
            font-size: 18px;
        }
        
        .category-meta {
            flex: 1;
        }
        
        .category-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 4px;
        }
        
        .category-description {
            color: var(--text-light);
            font-size: 14px;
            margin-bottom: 6px;
        }
        
        .category-date {
            font-size: 12px;
            color: var(--text-light);
        }
        
        .category-actions {
            display: flex;
            gap: 8px;
        }
        
        .action-btn {
            padding: 8px 12px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            font-size: 13px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
            border: none;
            cursor: pointer;
        }
        
        .btn-view {
            background-color: var(--light-bg);
            color: var(--text-dark);
        }
        
        .btn-view:hover {
            background-color: var(--border-color);
            color: var(--text-dark);
        }
        
        .btn-edit {
            background-color: var(--warning-color);
            color: white;
        }
        
        .btn-edit:hover {
            background-color: #e67e22;
            color: white;
        }
        
        .empty-state {
            background-color: var(--card-bg);
            border-radius: 8px;
            box-shadow: var(--shadow);
            padding: 60px 20px;
            text-align: center;
        }
        
        .empty-icon {
            font-size: 64px;
            color: var(--text-light);
            margin-bottom: 20px;
        }
        
        .empty-title {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 12px;
            color: var(--text-dark);
        }
        
        .empty-text {
            color: var(--text-light);
            margin-bottom: 24px;
            font-size: 16px;
        }
        
        .create-first-btn {
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: 8px;
            padding: 12px 24px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 16px;
        }
        
        .create-first-btn:hover {
            background-color: #166fe5;
            color: white;
        }
        
        @media (max-width: 768px) {
            .main-container {
                margin: 10px auto;
                padding: 0 8px;
            }
            
            .category-card,
            .page-header,
            .stats-bar {
                border-radius: 0;
                margin-bottom: 10px;
            }
            
            .category-header {
                padding: 16px;
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
            }
            
            .category-actions {
                width: 100%;
                justify-content: flex-end;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <!-- Header -->
    <header class="header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-6">
                    <a href="{{ path('app_article_index') }}" class="logo">Blog</a>
                </div>
                <div class="col-6 text-end">
                    <a href="{{ path('app_category_new') }}" class="create-btn-header">
                        <i class="bi bi-plus"></i>
                        Nouvelle Catégorie
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <div class="main-container">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">Gestion des Catégories</h1>
            <p class="page-subtitle">Organisez vos articles par catégories</p>
        </div>

        <!-- Stats Bar -->
        <div class="stats-bar">
            <div class="stats-item">
                <span class="stats-number">{{ categories|length }}</span>
                <span class="stats-label">CATÉGORIES</span>
            </div>
        </div>

        <!-- Categories List -->
        {% if categories|length > 0 %}
            {% for category in categories %}
                <div class="category-card">
                    <div class="category-header">
                        <div class="category-info">
                            <div class="category-icon">
                                <i class="bi bi-folder"></i>
                            </div>
                            <div class="category-meta">
                                <div class="category-title">{{ category.title }}</div>
                                <div class="category-description">
                                    {{ category.description|default('Aucune description') }}
                                </div>
                                <div class="category-date">
                                    Créée le {{ category.createdAt ? category.createdAt|date('d M Y à H:i') : 'Date inconnue' }}
                                </div>
                            </div>
                        </div>
                        <div class="category-actions">
                            <a href="{{ path('app_category_show', {'id': category.id}) }}" class="action-btn btn-view">
                                <i class="bi bi-eye"></i>
                                Voir
                            </a>
                            <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="action-btn btn-edit">
                                <i class="bi bi-pencil"></i>
                                Modifier
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div class="empty-state">
                <i class="bi bi-folder-plus empty-icon"></i>
                <h3 class="empty-title">Aucune catégorie</h3>
                <p class="empty-text">Commencez par créer votre première catégorie pour organiser vos articles</p>
                <a href="{{ path('app_category_new') }}" class="create-first-btn">
                    <i class="bi bi-plus-circle"></i>
                    Créer une catégorie
                </a>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Animation des cartes au scroll
            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry, index) => {
                    if (entry.isIntersecting) {
                        setTimeout(() => {
                            entry.target.style.opacity = '1';
                            entry.target.style.transform = 'translateY(0)';
                        }, index * 100);
                    }
                });
            });

            document.querySelectorAll('.category-card').forEach(card => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';
                card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                observer.observe(card);
            });
        });
    </script>
{% endblock %}
