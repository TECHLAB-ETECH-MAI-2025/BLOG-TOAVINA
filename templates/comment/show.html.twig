{% extends 'base.html.twig' %}

{% block title %}Commentaire de {{ comment.author }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #1877f2;
            --light-bg: #f0f2f5;
            --border-color: #dddfe2;
            --text-dark: #1c1e21;
            --text-light: #65676b;
            --card-bg: #ffffff;
            --shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
            --warning-color: #f39c12;
            --danger-color: #e74c3c;
        }
        
        body {
            background-color: var(--light-bg);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: var(--text-dark);
        }
        
        .header {
            background-color: var(--card-bg);
            border-bottom: 1px solid var(--border-color);
            padding: 12px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: var(--shadow);
        }
        
        .logo {
            font-size: 24px;
            font-weight: bold;
            color: var(--primary-color);
            text-decoration: none;
        }
        
        .back-btn {
            background-color: var(--light-bg);
            color: var(--text-dark);
            border: none;
            border-radius: 6px;
            padding: 8px 16px;
            font-weight: 600;
            text-decoration: none;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        
        .back-btn:hover {
            background-color: var(--border-color);
            color: var(--text-dark);
        }
        
        .main-container {
            max-width: 680px;
            margin: 20px auto;
            padding: 0 16px;
        }
        
        .comment-card {
            background-color: var(--card-bg);
            border-radius: 8px;
            box-shadow: var(--shadow);
            margin-bottom: 20px;
            overflow: hidden;
        }
        
        .comment-header {
            padding: 24px;
            text-align: center;
            border-bottom: 1px solid var(--border-color);
        }
        
        .comment-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(45deg, #667eea, #764ba2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 32px;
            margin: 0 auto 16px;
        }
        
        .comment-author-name {
            font-size: 24px;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 8px;
        }
        
        .comment-date {
            color: var(--text-light);
            font-size: 14px;
        }
        
        .comment-body {
            padding: 24px;
            border-bottom: 1px solid var(--border-color);
        }
        
        .comment-content {
            font-size: 16px;
            line-height: 1.6;
            color: var(--text-dark);
            background-color: var(--light-bg);
            padding: 16px;
            border-radius: 8px;
            border-left: 4px solid var(--primary-color);
        }
        
        .comment-details {
            padding: 24px;
        }
        
        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid var(--light-bg);
        }
        
        .detail-row:last-child {
            border-bottom: none;
        }
        
        .detail-label {
            font-weight: 600;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .detail-value {
            color: var(--text-light);
            text-align: right;
        }
        
        .comment-actions {
            border-top: 1px solid var(--border-color);
            display: flex;
        }
        
        .action-btn {
            flex: 1;
            background: none;
            border: none;
            padding: 16px;
            color: var(--text-light);
            font-weight: 600;
            font-size: 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s;
            text-decoration: none;
        }
        
        .action-btn:hover {
            background-color: var(--light-bg);
            color: var(--text-dark);
        }
        
        .action-btn.btn-edit:hover {
            background-color: rgba(243, 156, 18, 0.1);
            color: var(--warning-color);
        }
        
        .action-btn.btn-delete:hover {
            background-color: rgba(231, 76, 60, 0.1);
            color: var(--danger-color);
        }
        
        .action-btn i {
            font-size: 18px;
        }
        
        /* Navigation Commentaires */
        .comment-navigation {
            background-color: var(--card-bg);
            border-radius: 8px;
            box-shadow: var(--shadow);
            margin-bottom: 20px;
            overflow: hidden;
        }

        .nav-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border-color);
            font-weight: 600;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .nav-buttons {
            display: flex;
        }

        .nav-btn {
            flex: 1;
            padding: 16px 20px;
            background: none;
            border: none;
            text-decoration: none;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 12px;
            transition: background-color 0.2s;
            min-height: 80px;
        }

        .nav-btn:hover {
            background-color: var(--light-bg);
            color: var(--text-dark);
        }

        .nav-btn.disabled {
            opacity: 0.5;
            cursor: not-allowed;
            pointer-events: none;
        }

        .nav-btn + .nav-btn {
            border-left: 1px solid var(--border-color);
        }

        .nav-icon {
            font-size: 24px;
            color: var(--primary-color);
        }

        .nav-content {
            flex: 1;
        }

        .nav-label {
            font-size: 12px;
            color: var(--text-light);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .nav-title {
            font-weight: 600;
            font-size: 14px;
            line-height: 1.3;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        
        @media (max-width: 768px) {
            .main-container {
                margin: 10px auto;
                padding: 0 8px;
            }
            
            .comment-card {
                border-radius: 0;
                margin-bottom: 10px;
            }
            
            .comment-header,
            .comment-body,
            .comment-details {
                padding: 20px;
            }
            
            .detail-row {
                flex-direction: column;
                align-items: flex-start;
                gap: 4px;
            }
            
            .detail-value {
                text-align: left;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <!-- Header -->
    <header class="header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-6">
                    <a href="{{ path('app_article_index') }}" class="logo">Blog</a>
                </div>
                <div class="col-6 text-end">
                    <a href="{{ path('app_comment_index') }}" class="back-btn">
                        <i class="bi bi-arrow-left"></i>
                        Retour
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <div class="main-container">
        <!-- Navigation Commentaires -->
        <div class="comment-navigation">
            <div class="nav-header">
                <i class="bi bi-arrow-left-right"></i>
                Navigation
            </div>
            <div class="nav-buttons">
                {% if previousComment %}
                    <a href="{{ path('app_comment_show', {'id': previousComment.id}) }}" class="nav-btn">
                        <i class="bi bi-chevron-left nav-icon"></i>
                        <div class="nav-content">
                            <div class="nav-label">Commentaire précédent</div>
                            <div class="nav-title">{{ previousComment.author }}</div>
                        </div>
                    </a>
                {% else %}
                    <div class="nav-btn disabled">
                        <i class="bi bi-chevron-left nav-icon"></i>
                        <div class="nav-content">
                            <div class="nav-label">Commentaire précédent</div>
                            <div class="nav-title">Aucun commentaire précédent</div>
                        </div>
                    </div>
                {% endif %}
                
                {% if nextComment %}
                    <a href="{{ path('app_comment_show', {'id': nextComment.id}) }}" class="nav-btn">
                        <div class="nav-content">
                            <div class="nav-label">Commentaire suivant</div>
                            <div class="nav-title">{{ nextComment.author }}</div>
                        </div>
                        <i class="bi bi-chevron-right nav-icon"></i>
                    </a>
                {% else %}
                    <div class="nav-btn disabled">
                        <div class="nav-content">
                            <div class="nav-label">Commentaire suivant</div>
                            <div class="nav-title">Aucun commentaire suivant</div>
                        </div>
                        <i class="bi bi-chevron-right nav-icon"></i>
                    </div>
                {% endif %}
            </div>
        </div>
        <div class="comment-card">
            <!-- Comment Header -->
            <div class="comment-header">
                <div class="comment-avatar">
                    <i class="bi bi-person"></i>
                </div>
                <h1 class="comment-author-name">{{ comment.author }}</h1>
                <div class="comment-date">
                    Commenté le {{ comment.createdAt ? comment.createdAt|date('d M Y à H:i') : 'Date inconnue' }}
                </div>
            </div>
            
            <!-- Comment Body -->
            <div class="comment-body">
                <div class="comment-content">
                    {{ comment.content|nl2br }}
                </div>
            </div>
            
            <!-- Comment Details -->
            <div class="comment-details">
                <div class="detail-row">
                    <div class="detail-label">
                        <i class="bi bi-hash"></i>
                        ID
                    </div>
                    <div class="detail-value">{{ comment.id }}</div>
                </div>
                
                <div class="detail-row">
                    <div class="detail-label">
                        <i class="bi bi-person"></i>
                        Auteur
                    </div>
                    <div class="detail-value">{{ comment.author }}</div>
                </div>
                
                <div class="detail-row">
                    <div class="detail-label">
                        <i class="bi bi-calendar"></i>
                        Date de création
                    </div>
                    <div class="detail-value">
                        {{ comment.createdAt ? comment.createdAt|date('d M Y à H:i:s') : 'Date inconnue' }}
                    </div>
                </div>
                
                <div class="detail-row">
                    <div class="detail-label">
                        <i class="bi bi-file-text"></i>
                        Article
                    </div>
                    <div class="detail-value">
                        {% if comment.article %}
                            <a href="{{ path('app_article_show', {'id': comment.article.id}) }}" style="color: var(--primary-color); text-decoration: none;">
                                {{ comment.article.title }}
                            </a>
                        {% else %}
                            Non associé
                        {% endif %}
                    </div>
                </div>
            </div>
            
            <!-- Comment Actions -->
            <div class="comment-actions">
                <a href="{{ path('app_comment_edit', {'id': comment.id}) }}" class="action-btn btn-edit">
                    <i class="bi bi-pencil"></i>
                    Modifier
                </a>
                <button type="button" class="action-btn btn-delete" onclick="confirmDelete()">
                    <i class="bi bi-trash"></i>
                    Supprimer
                </button>
            </div>
        </div>
    </div>

    <!-- Hidden Delete Form -->
    <div style="display: none;">
        {{ include('comment/_delete_form.html.twig') }}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Animation d'apparition
            const elements = document.querySelectorAll('.comment-card, .comment-navigation');
            elements.forEach((element, index) => {
                element.style.opacity = '0';
                element.style.transform = 'translateY(20px)';
                element.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                
                setTimeout(() => {
                    element.style.opacity = '1';
                    element.style.transform = 'translateY(0)';
                }, index * 100);
            });
            
            function confirmDelete() {
                if (confirm('Êtes-vous sûr de vouloir supprimer ce commentaire ?')) {
                    document.querySelector('form[action*="delete"]').submit();
                }
            }
        });
    </script>
{% endblock %}
