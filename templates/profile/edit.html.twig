{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block body %}
<div class="container py-4">
    <!-- Messages flash -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show mb-4" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row">
        <!-- Menu latéral -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Menu</h5>
                </div>
                <div class="list-group list-group-flush">
                    <a href="{{ path('app_profile') }}" class="list-group-item list-group-item-action">
                        <i class="bi bi-person-circle me-2"></i> Mon profil
                    </a>
                    <a href="{{ path('app_profile_edit') }}" class="list-group-item list-group-item-action active">
                        <i class="bi bi-pencil-square me-2"></i> Modifier mon profil
                    </a>
                    <a href="{{ path('app_profile_change_password') }}" class="list-group-item list-group-item-action">
                        <i class="bi bi-key me-2"></i> Changer mon mot de passe
                    </a>
                    <a href="{{ path('app_logout') }}" class="list-group-item list-group-item-action text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i> Déconnexion
                    </a>
                </div>
            </div>
        </div>
        
        <!-- Contenu principal -->
        <div class="col-md-9">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex align-items-center">
                    <i class="bi bi-pencil-square me-2"></i>
                    <h5 class="mb-0">Modifier mon profil</h5>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div class="avatar-edit-container">
                            <div class="avatar-edit">
                                {{ app.user.firstName|slice(0, 1)|upper }}{{ app.user.lastName|slice(0, 1)|upper }}
                            </div>
                            <div class="avatar-edit-overlay">
                                <i class="bi bi-camera"></i>
                            </div>
                        </div>
                        <h5 class="mt-3 mb-0">{{ app.user.firstName }} {{ app.user.lastName }}</h5>
                        <p class="text-muted">{{ app.user.email }}</p>
                    </div>

                    {{ form_start(profileForm, {'attr': {'class': 'needs-validation'}}) }}
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="bi bi-person me-2"></i>Informations personnelles</h6>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-md-6 mb-3 mb-md-0">
                                        {{ form_label(profileForm.firstName, null, {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(profileForm.firstName, {'attr': {'class': 'form-control'}}) }}
                                        {% if form_errors(profileForm.firstName) %}
                                            <div class="invalid-feedback d-block">
                                                {{ form_errors(profileForm.firstName) }}
                                            </div>
                                        {% endif %}
                                    </div>
                                    
                                    <div class="col-md-6">
                                        {{ form_label(profileForm.lastName, null, {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(profileForm.lastName, {'attr': {'class': 'form-control'}}) }}
                                        {% if form_errors(profileForm.lastName) %}
                                            <div class="invalid-feedback d-block">
                                                {{ form_errors(profileForm.lastName) }}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="bi bi-envelope me-2"></i>Coordonnées</h6>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    {{ form_label(profileForm.email, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(profileForm.email, {'attr': {'class': 'form-control'}}) }}
                                    {% if form_errors(profileForm.email) %}
                                        <div class="invalid-feedback d-block">
                                            {{ form_errors(profileForm.email) }}
                                        </div>
                                    {% endif %}
                                    <div class="form-text">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Cette adresse sera utilisée pour les communications importantes.
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="d-flex justify-content-between mb-4">
                            <a href="{{ path('app_profile') }}" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Retour
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-1"></i> Enregistrer les modifications
                            </button>
                        </div>
                    {{ form_end(profileForm) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .avatar-edit-container {
        position: relative;
        display: inline-block;
        margin: 0 auto;
    }
    
    .avatar-edit {
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, #0d6efd, #0dcaf0);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        font-weight: bold;
        border: 4px solid white;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }
    
    .avatar-edit-overlay {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 32px;
        height: 32px;
        background: #0d6efd;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        border: 2px solid white;
        cursor: pointer;
    }
    
    .bg-primary {
        background: linear-gradient(135deg, #0d6efd, #0dcaf0) !important;
    }
    
    .btn-primary {
        background: linear-gradient(135deg, #0d6efd, #0dcaf0);
        border: none;
    }
    
    .btn-primary:hover {
        background: linear-gradient(135deg, #0b5ed7, #0bacbe);
    }
    
    .list-group-item.active {
        background: linear-gradient(135deg, #0d6efd, #0dcaf0);
        border-color: #0d6efd;
    }
</style>
{% endblock %}
