{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
<div class="container py-4">
    <!-- Messages flash -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show mb-4" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Header avec bannière -->
    <div class="card border-0 mb-4 profile-header">
        <div class="card-img-top profile-banner"></div>
        <div class="card-body position-relative pt-0">
            <div class="profile-avatar">
                <div class="avatar-circle">
                    {{ app.user.firstName|slice(0, 1)|upper }}{{ app.user.lastName|slice(0, 1)|upper }}
                </div>
                {% if app.user.isVerified %}
                    <span class="badge bg-success position-absolute verification-badge">
                        <i class="bi bi-check-circle-fill"></i>
                    </span>
                {% endif %}
            </div>
            
            <div class="row align-items-end mt-3">
                <div class="col-md-8">
                    <h1 class="profile-name">{{ app.user.firstName ?: 'Utilisateur' }} {{ app.user.lastName ?: '' }}</h1>
                    <p class="text-muted mb-2">{{ app.user.email }}</p>
                    <div class="d-flex gap-3 profile-stats">
                        <div class="text-center">
                            <span class="d-block fw-bold">{{ app.user.createdAt|date('d/m/Y') }}</span>
                            <small class="text-muted">Inscrit le</small>
                        </div>
                        <div class="text-center">
                            <span class="d-block fw-bold">
                                {% if app.user.isVerified %}
                                    <i class="bi bi-shield-check text-success"></i> Vérifié
                                {% else %}
                                    <i class="bi bi-shield text-warning"></i> Non vérifié
                                {% endif %}
                            </span>
                            <small class="text-muted">Statut</small>
                        </div>
                        <div class="text-center">
                            <span class="d-block fw-bold">
                                {% if 'ROLE_ADMIN' in app.user.roles %}
                                    <i class="bi bi-star-fill text-primary"></i> Admin
                                {% else %}
                                    <i class="bi bi-person-fill"></i> Utilisateur
                                {% endif %}
                            </span>
                            <small class="text-muted">Rôle</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <a href="{{ path('app_profile_edit') }}" class="btn btn-primary">
                        <i class="bi bi-pencil-square me-2"></i>Modifier le profil
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Menu latéral -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Menu</h5>
                </div>
                <div class="list-group list-group-flush">
                    <a href="{{ path('app_profile') }}" class="list-group-item list-group-item-action active">
                        <i class="bi bi-person-circle me-2"></i> Mon profil
                    </a>
                    <a href="{{ path('app_profile_edit') }}" class="list-group-item list-group-item-action">
                        <i class="bi bi-pencil-square me-2"></i> Modifier mon profil
                    </a>
                    <a href="{{ path('app_profile_change_password') }}" class="list-group-item list-group-item-action">
                        <i class="bi bi-key me-2"></i> Changer mon mot de passe
                    </a>
                    <a href="{{ path('app_logout') }}" class="list-group-item list-group-item-action text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i> Déconnexion
                    </a>
                </div>
            </div>
        </div>
        
        <!-- Contenu principal -->
        <div class="col-md-9">
            <div class="row">
                <!-- Informations personnelles -->
                <div class="col-lg-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-primary text-white d-flex align-items-center">
                            <i class="bi bi-person-fill me-2"></i>
                            <h5 class="mb-0">Informations personnelles</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3 pb-3 border-bottom">
                                <div class="text-muted small mb-1">Prénom</div>
                                <div class="fw-medium">{{ app.user.firstName|default('Non renseigné') }}</div>
                            </div>
                            <div class="mb-3 pb-3 border-bottom">
                                <div class="text-muted small mb-1">Nom</div>
                                <div class="fw-medium">{{ app.user.lastName|default('Non renseigné') }}</div>
                            </div>
                            <div>
                                <div class="text-muted small mb-1">Email</div>
                                <div class="fw-medium">{{ app.user.email }}</div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Informations du compte -->
                <div class="col-lg-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-primary text-white d-flex align-items-center">
                            <i class="bi bi-shield me-2"></i>
                            <h5 class="mb-0">Informations du compte</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3 pb-3 border-bottom">
                                <div class="text-muted small mb-1">Date d'inscription</div>
                                <div class="fw-medium">{{ app.user.createdAt|date('d/m/Y') }}</div>
                            </div>
                            <div class="mb-3 pb-3 border-bottom">
                                <div class="text-muted small mb-1">Rôle</div>
                                <div>
                                    {% if 'ROLE_ADMIN' in app.user.roles %}
                                        <span class="badge bg-primary">Administrateur</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Utilisateur</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div>
                                <div class="text-muted small mb-1">Statut</div>
                                <div>
                                    {% if app.user.isVerified %}
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle-fill me-1"></i>Email vérifié
                                        </span>
                                    {% else %}
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>Email non vérifié
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Actions rapides -->
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-header bg-primary text-white d-flex align-items-center">
                            <i class="bi bi-lightning-charge me-2"></i>
                            <h5 class="mb-0">Actions rapides</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <a href="{{ path('app_profile_edit') }}" class="card action-card text-decoration-none h-100">
                                        <div class="card-body d-flex align-items-center">
                                            <div class="action-icon bg-primary text-white me-3">
                                                <i class="bi bi-pencil-square"></i>
                                            </div>
                                            <div>
                                                <h5 class="card-title mb-1">Modifier le profil</h5>
                                                <p class="card-text text-muted small">Mettre à jour vos informations personnelles</p>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-md-6">
                                    <a href="{{ path('app_profile_change_password') }}" class="card action-card text-decoration-none h-100">
                                        <div class="card-body d-flex align-items-center">
                                            <div class="action-icon bg-primary text-white me-3">
                                                <i class="bi bi-shield-lock"></i>
                                            </div>
                                            <div>
                                                <h5 class="card-title mb-1">Changer le mot de passe</h5>
                                                <p class="card-text text-muted small">Renforcer la sécurité de votre compte</p>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .profile-header {
        overflow: hidden;
    }
    
    .profile-banner {
        height: 180px;
        background: linear-gradient(135deg, #0d6efd, #0dcaf0);
    }
    
    .profile-avatar {
        margin-top: -50px;
        position: relative;
        display: inline-block;
    }
    
    .avatar-circle {
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, #0d6efd, #0dcaf0);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        font-weight: bold;
        border: 4px solid white;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }
    
    .verification-badge {
        bottom: 0;
        right: 0;
        border: 2px solid white;
    }
    
    .profile-name {
        font-size: 1.75rem;
        font-weight: 600;
        margin-bottom: 0.25rem;
    }
    
    .profile-stats {
        margin-top: 1rem;
    }
    
    .action-card {
        transition: transform 0.2s, box-shadow 0.2s;
        border: 1px solid rgba(0,0,0,0.125);
    }
    
    .action-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        border-color: #0d6efd;
    }
    
    .action-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }
    
    .bg-primary {
        background: linear-gradient(135deg, #0d6efd, #0dcaf0) !important;
    }
    
    .btn-primary {
        background: linear-gradient(135deg, #0d6efd, #0dcaf0);
        border: none;
    }
    
    .btn-primary:hover {
        background: linear-gradient(135deg, #0b5ed7, #0bacbe);
    }
    
    .list-group-item.active {
        background: linear-gradient(135deg, #0d6efd, #0dcaf0);
        border-color: #0d6efd;
    }
</style>
{% endblock %}
