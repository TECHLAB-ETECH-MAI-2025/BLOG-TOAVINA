{% extends 'base.html.twig' %}

{% block title %}Article index{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #1877f2;
            --light-bg: #f0f2f5;
            --border-color: #dddfe2;
            --text-dark: #1c1e21;
            --text-light: #65676b;
            --card-bg: #ffffff;
            --shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
        }
        
        body {
            background-color: var(--light-bg);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: var(--text-dark);
        }
        
        .header {
            background-color: var(--card-bg);
            border-bottom: 1px solid var(--border-color);
            padding: 12px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: var(--shadow);
        }
        
        .logo {
            font-size: 24px;
            font-weight: bold;
            color: var(--primary-color);
            text-decoration: none;
        }
        
        .create-btn-header {
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: 6px;
            padding: 8px 16px;
            font-weight: 600;
            text-decoration: none;
            font-size: 14px;
        }
        
        .create-btn-header:hover {
            background-color: #166fe5;
            color: white;
        }
        
        .main-container {
            max-width: 680px;
            margin: 20px auto;
            padding: 0 16px;
        }
        
        .stats-bar {
            background-color: var(--card-bg);
            border-radius: 8px;
            box-shadow: var(--shadow);
            padding: 16px 20px;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .stats-item {
            text-align: center;
        }
        
        .stats-number {
            font-size: 20px;
            font-weight: bold;
            color: var(--primary-color);
            display: block;
        }
        
        .stats-label {
            font-size: 12px;
            color: var(--text-light);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .post-card {
            background-color: var(--card-bg);
            border-radius: 8px;
            box-shadow: var(--shadow);
            margin-bottom: 20px;
            overflow: hidden;
        }
        
        .post-header {
            padding: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        
        .post-info {
            display: flex;
            align-items: center;
        }
        
        .post-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(45deg, #667eea, #764ba2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            margin-right: 12px;
        }
        
        .post-meta {
            flex: 1;
        }
        
        .post-title {
            font-weight: 600;
            font-size: 15px;
            color: var(--text-dark);
            text-decoration: none;
            display: block;
            margin-bottom: 2px;
        }
        
        .post-title:hover {
            color: var(--text-dark);
            text-decoration: underline;
        }
        
        .post-date {
            font-size: 13px;
            color: var(--text-light);
        }
        
        .post-menu {
            color: var(--text-light);
            background: none;
            border: none;
            font-size: 20px;
            padding: 4px;
            border-radius: 50%;
            cursor: pointer;
        }
        
        .post-menu:hover {
            background-color: var(--light-bg);
        }
        
        .post-content {
            padding: 0 16px 16px;
            font-size: 15px;
            line-height: 1.33;
            color: var(--text-dark);
        }
        
        .post-content-preview {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        
        .read-more {
            color: var(--text-light);
            font-weight: 600;
            cursor: pointer;
            margin-top: 4px;
        }
        
        .read-more:hover {
            text-decoration: underline;
        }
        
        .post-actions {
            border-top: 1px solid var(--border-color);
            display: flex;
        }
        
        .action-btn {
            flex: 1;
            background: none;
            border: none;
            padding: 12px;
            color: var(--text-light);
            font-weight: 600;
            font-size: 15px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background-color 0.2s;
            text-decoration: none;
        }
        
        .action-btn:hover {
            background-color: var(--light-bg);
            color: var(--text-dark);
        }
        
        .action-btn i {
            font-size: 18px;
        }
        
        /* Navigation Articles */
        .article-navigation {
            background-color: var(--card-bg);
            border-radius: 8px;
            box-shadow: var(--shadow);
            margin-bottom: 20px;
            overflow: hidden;
        }
        
        .nav-header {
            padding: 12px 16px;
            border-bottom: 1px solid var(--border-color);
            font-weight: 600;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
        }
        
        .nav-buttons {
            display: flex;
        }
        
        .nav-btn {
            flex: 1;
            padding: 12px 16px;
            background: none;
            border: none;
            text-decoration: none;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 8px;
            transition: background-color 0.2s;
            font-size: 14px;
        }
        
        .nav-btn:hover {
            background-color: var(--light-bg);
            color: var(--text-dark);
        }
        
        .nav-btn.disabled {
            opacity: 0.5;
            cursor: not-allowed;
            pointer-events: none;
        }
        
        .nav-btn + .nav-btn {
            border-left: 1px solid var(--border-color);
        }
        
        .nav-icon {
            font-size: 18px;
            color: var(--primary-color);
        }
        
        /* Pagination Styles */
        .pagination-container {
            background-color: var(--card-bg);
            border-radius: 8px;
            box-shadow: var(--shadow);
            padding: 20px;
            margin-top: 20px;
        }
        
        .pagination-info {
            text-align: center;
            margin-bottom: 16px;
            color: var(--text-light);
            font-size: 14px;
        }
        
        .pagination-wrapper {
            display: flex;
            justify-content: center;
        }
        
        /* Style pour la pagination Bootstrap */
        .pagination {
            margin: 0;
        }
        
        .pagination .page-link {
            color: var(--text-dark);
            background-color: var(--light-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            margin: 0 2px;
            padding: 8px 12px;
            font-weight: 600;
            font-size: 14px;
        }
        
        .pagination .page-link:hover {
            background-color: var(--primary-color);
            color: white;
            border-color: var(--primary-color);
        }
        
        .pagination .page-item.active .page-link {
            background-color: var(--primary-color);
            color: white;
            border-color: var(--primary-color);
        }
        
        .pagination .page-item.disabled .page-link {
            background-color: transparent;
            color: var(--text-light);
            border-color: transparent;
            opacity: 0.5;
        }
        
        /* Empty State */
        .empty-state {
            background-color: var(--card-bg);
            border-radius: 8px;
            box-shadow: var(--shadow);
            padding: 40px 20px;
            text-align: center;
        }
        
        .empty-icon {
            font-size: 48px;
            color: var(--text-light);
            margin-bottom: 16px;
        }
        
        .empty-title {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 8px;
        }
        
        .empty-text {
            color: var(--text-light);
            margin-bottom: 20px;
        }
        
        .create-first-btn {
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: 6px;
            padding: 12px 24px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
        }
        
        .create-first-btn:hover {
            background-color: #166fe5;
            color: white;
        }
        
        @media (max-width: 768px) {
            .main-container {
                margin: 10px auto;
                padding: 0 8px;
            }
            
            .post-card,
            .stats-bar,
            .pagination-container,
            .article-navigation {
                border-radius: 0;
                margin-bottom: 10px;
            }
            
            .stats-bar {
                flex-direction: column;
                gap: 12px;
            }
            
            .pagination .page-link {
                padding: 6px 10px;
                font-size: 13px;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <!-- Header -->
    <header class="header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-6">
                    <a href="{{ path('app_article_index') }}" class="logo">Blog</a>
                </div>
                <div class="col-6 text-end">
                    <a href="{{ path('app_article_new') }}" class="create-btn-header">
                        <i class="bi bi-plus me-1"></i>
                        Créer
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <div class="main-container">
        <!-- Stats Bar -->
        <div class="stats-bar">
            <div class="stats-item">
                <span class="stats-number">{{ articles.getTotalItemCount }}</span>
                <span class="stats-label">ARTICLES</span>
            </div>
            <div class="stats-item">
                <span class="stats-number">{{ articles.getCurrentPageNumber }}</span>
                <span class="stats-label">PAGE</span>
            </div>
            <div class="stats-item">
                <span class="stats-number">{{ articles.getPageCount }}</span>
                <span class="stats-label">PAGES</span>
            </div>
        </div>

        <!-- Navigation Articles -->
        {% if articles.getPageCount > 1 %}
        <div class="article-navigation">
            <div class="nav-header">
                <i class="bi bi-arrow-left-right"></i>
                Navigation
            </div>
            <div class="nav-buttons">
                {% if articles.getCurrentPageNumber > 1 %}
                    <a href="{{ path('app_article_index', {'page': articles.getCurrentPageNumber - 1}) }}" class="nav-btn">
                        <i class="bi bi-chevron-left nav-icon"></i>
                        Page précédente
                    </a>
                {% else %}
                    <div class="nav-btn disabled">
                        <i class="bi bi-chevron-left nav-icon"></i>
                        Page précédente
                    </div>
                {% endif %}
                
                {% if articles.getCurrentPageNumber < articles.getPageCount %}
                    <a href="{{ path('app_article_index', {'page': articles.getCurrentPageNumber + 1}) }}" class="nav-btn">
                        Page suivante
                        <i class="bi bi-chevron-right nav-icon"></i>
                    </a>
                {% else %}
                    <div class="nav-btn disabled">
                        Page suivante
                        <i class="bi bi-chevron-right nav-icon"></i>
                    </div>
                {% endif %}
            </div>
        </div>
        {% endif %}

        <!-- Articles List -->
        {% if articles|length > 0 %}
            {% for article in articles %}
                <div class="post-card">
                    <div class="post-header">
                        <div class="post-info">
                            <div class="post-avatar">
                                {{ article.id }}
                            </div>
                            <div class="post-meta">
                                <a href="{{ path('app_article_show', {'id': article.id}) }}" class="post-title">
                                    {{ article.title }}
                                </a>
                                <div class="post-date">
                                    {{ article.createdAt ? article.createdAt|date('d M Y à H:i') : 'Date inconnue' }}
                                </div>
                            </div>
                        </div>
                        <div class="post-menu">
                            <i class="bi bi-three-dots"></i>
                        </div>
                    </div>
                    
                    <div class="post-content">
                        <div class="post-content-preview">
                            {{ article.content }}
                        </div>
                        {% if article.content|length > 200 %}
                            <div class="read-more">Voir plus</div>
                        {% endif %}
                    </div>
                    
                    <div class="post-actions">
                        <a href="{{ path('app_article_show', {'id': article.id}) }}" class="action-btn">
                            <i class="bi bi-eye"></i>
                            Voir
                        </a>
                        <a href="{{ path('app_article_edit', {'id': article.id}) }}" class="action-btn">
                            <i class="bi bi-pencil"></i>
                            Modifier
                        </a>
                    </div>
                </div>
            {% endfor %}

            <!-- Pagination -->
            {% if articles.getPageCount > 1 %}
            <div class="pagination-container">
                {% set startItem = (articles.getCurrentPageNumber - 1) * articles.getItemNumberPerPage + 1 %}
                {% set endItem = articles.getCurrentPageNumber * articles.getItemNumberPerPage %}
                {% if endItem > articles.getTotalItemCount %}
                    {% set endItem = articles.getTotalItemCount %}
                {% endif %}
                
                <div class="pagination-info">
                    Affichage de {{ startItem }} à {{ endItem }} 
                    sur {{ articles.getTotalItemCount }} articles
                </div>
            
            </div>
            {% endif %}
        {% else %}
            <div class="empty-state">
                <i class="bi bi-journal-text empty-icon"></i>
                <h3 class="empty-title">Aucun article</h3>
                <p class="empty-text">Commencez par créer votre premier article</p>
                <a href="{{ path('app_article_new') }}" class="create-first-btn">Créer un article</a>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Animate post cards on scroll
            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry, index) => {
                    if (entry.isIntersecting) {
                        setTimeout(() => {
                            entry.target.style.opacity = '1';
                            entry.target.style.transform = 'translateY(0)';
                        }, index * 100);
                    }
                });
            });

            document.querySelectorAll('.post-card, .article-navigation').forEach(card => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';
                card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                observer.observe(card);
            });
            
            // Menu dropdown
            document.querySelectorAll('.post-menu').forEach(menu => {
                menu.addEventListener('click', function() {
                    console.log('Menu clicked');
                });
            });
            
            // Read more functionality
            document.querySelectorAll('.read-more').forEach(btn => {
                btn.addEventListener('click', function() {
                    const preview = this.previousElementSibling;
                    preview.style.display = 'block';
                    preview.style.webkitLineClamp = 'unset';
                    this.style.display = 'none';
                });
            });
        });
    </script>
{% endblock %}
