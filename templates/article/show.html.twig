{% extends 'base.html.twig' %}

{% block title %}{{ article.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #1877f2;
            --like-color: #e91e63;
            --light-bg: #f0f2f5;
            --border-color: #dddfe2;
            --text-dark: #1c1e21;
            --text-light: #65676b;
            --card-bg: #ffffff;
            --shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
            --shadow-hover: 0 2px 8px rgba(0, 0, 0, 0.15);
        }
        
        body {
            background-color: var(--light-bg);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: var(--text-dark);
        }
        
        .header {
            background-color: var(--card-bg);
            border-bottom: 1px solid var(--border-color);
            padding: 12px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: var(--shadow);
        }
        
        .logo {
            font-size: 24px;
            font-weight: bold;
            color: var(--primary-color);
            text-decoration: none;
        }
        
        .back-btn {
            background-color: var(--light-bg);
            color: var(--text-dark);
            border: none;
            border-radius: 6px;
            padding: 8px 16px;
            font-weight: 600;
            text-decoration: none;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        
        .back-btn:hover {
            background-color: var(--border-color);
            color: var(--text-dark);
        }
        
        .main-container {
            max-width: 680px;
            margin: 20px auto;
            padding: 0 16px;
        }
        
        .article-card {
            background-color: var(--card-bg);
            border-radius: 8px;
            box-shadow: var(--shadow);
            margin-bottom: 20px;
            overflow: hidden;
        }
        
        .article-header {
            padding: 20px;
            border-bottom: 1px solid var(--border-color);
        }
        
        .article-meta {
            display: flex;
            align-items: center;
            margin-bottom: 16px;
        }
        
        .article-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(45deg, #667eea, #764ba2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            margin-right: 16px;
            font-size: 18px;
        }
        
        .article-info {
            flex: 1;
        }
        
        .article-title {
            font-size: 24px;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 4px;
            line-height: 1.2;
        }
        
        .article-date {
            font-size: 14px;
            color: var(--text-light);
        }
        
        .article-content {
            padding: 20px;
            font-size: 16px;
            line-height: 1.6;
            color: var(--text-dark);
        }
        
        .article-categories {
            padding: 0 20px 20px;
        }
        
        .category-tag {
            display: inline-block;
            background-color: var(--light-bg);
            color: var(--text-light);
            padding: 6px 12px;
            border-radius: 16px;
            font-size: 13px;
            font-weight: 500;
            margin-right: 8px;
            margin-bottom: 6px;
        }
        
        /* Likes Section */
        .likes-section {
            padding: 0 20px;
            margin-bottom: 16px;
        }
        
        .likes-info {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--text-light);
            font-size: 14px;
        }
        
        .likes-count {
            font-weight: 600;
        }
        
        .like-icon-small {
            width: 20px;
            height: 20px;
            background: linear-gradient(45deg, #ff6b6b, #ee5a24);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 11px;
        }
        
        /* Article Actions */
        .article-actions {
            border-top: 1px solid var(--border-color);
            display: flex;
        }
        
        .action-btn {
            flex: 1;
            background: none;
            border: none;
            padding: 16px;
            color: var(--text-light);
            font-weight: 600;
            font-size: 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s;
            text-decoration: none;
        }
        
        .action-btn:hover {
            background-color: var(--light-bg);
            color: var(--text-dark);
        }
        
        .action-btn i {
            font-size: 20px;
        }
        
        /* Like Button */
        .like-btn {
            transition: all 0.3s ease;
        }
        
        .like-btn:hover {
            background-color: rgba(233, 30, 99, 0.1);
            color: var(--like-color);
        }
        
        .like-btn.liked {
            color: var(--like-color);
        }
        
        .like-btn.liked:hover {
            background-color: rgba(233, 30, 99, 0.1);
        }
        
        @keyframes likeAnimation {
            0% { transform: scale(1); }
            50% { transform: scale(1.2); }
            100% { transform: scale(1); }
        }
        
        /* Navigation Articles */
        .article-navigation {
            background-color: var(--card-bg);
            border-radius: 8px;
            box-shadow: var(--shadow);
            margin-bottom: 20px;
            overflow: hidden;
        }
        
        .nav-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border-color);
            font-weight: 600;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .nav-buttons {
            display: flex;
        }
        
        .nav-btn {
            flex: 1;
            padding: 16px 20px;
            background: none;
            border: none;
            text-decoration: none;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 12px;
            transition: background-color 0.2s;
            min-height: 80px;
        }
        
        .nav-btn:hover {
            background-color: var(--light-bg);
            color: var(--text-dark);
        }
        
        .nav-btn.disabled {
            opacity: 0.5;
            cursor: not-allowed;
            pointer-events: none;
        }
        
        .nav-btn + .nav-btn {
            border-left: 1px solid var(--border-color);
        }
        
        .nav-icon {
            font-size: 24px;
            color: var(--primary-color);
        }
        
        .nav-content {
            flex: 1;
        }
        
        .nav-label {
            font-size: 12px;
            color: var(--text-light);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }
        
        .nav-title {
            font-weight: 600;
            font-size: 14px;
            line-height: 1.3;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        
        /* Comments */
        .comments-section {
            background-color: var(--card-bg);
            border-radius: 8px;
            box-shadow: var(--shadow);
            padding: 20px;
        }
        
        .comments-title {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 16px;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .comment-item {
            background-color: var(--light-bg);
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 12px;
            border-left: 3px solid var(--primary-color);
        }
        
        .comment-author {
            font-weight: 600;
            color: var(--text-dark);
            font-size: 15px;
            margin-bottom: 6px;
        }
        
        .comment-content {
            color: var(--text-dark);
            font-size: 15px;
            line-height: 1.4;
        }
        
        .no-comments {
            color: var(--text-light);
            font-style: italic;
            font-size: 15px;
            text-align: center;
            padding: 30px;
        }
        
        .comment-form {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid var(--border-color);
        }
        
        .comment-form-title {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 16px;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .form-control {
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 12px 16px;
            font-size: 15px;
            transition: border-color 0.2s;
            margin-bottom: 12px;
        }
        
        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(24, 119, 242, 0.1);
        }
        
        .btn-comment {
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: 8px;
            padding: 12px 20px;
            font-weight: 600;
            font-size: 15px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .btn-comment:hover {
            background-color: #166fe5;
        }
        
        @media (max-width: 768px) {
            .main-container {
                margin: 10px auto;
                padding: 0 8px;
            }
            
            .article-card,
            .article-navigation,
            .comments-section {
                border-radius: 0;
                margin-bottom: 10px;
            }
            
            .article-header,
            .article-content,
            .article-categories,
            .likes-section {
                padding: 16px;
            }
            
            .nav-btn {
                padding: 12px 16px;
                min-height: 70px;
            }
            
            .nav-title {
                font-size: 13px;
            }
            
            .action-btn {
                padding: 12px;
                font-size: 14px;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <!-- Header -->
    <header class="header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-6">
                    <a href="{{ path('app_blog_home') }}" class="logo">Blog</a>
                </div>
                <div class="col-6 text-end">
                    <a href="{{ path('app_blog_home') }}" class="back-btn">
                        <i class="bi bi-arrow-left"></i>
                        Retour
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <div class="main-container">
        <!-- Navigation Articles -->
        <div class="article-navigation">
            <div class="nav-header">
                <i class="bi bi-arrow-left-right"></i>
                Navigation
            </div>
            <div class="nav-buttons">
                {% if previousArticle %}
                    <a href="{{ path('app_article_show', {'id': previousArticle.id}) }}" class="nav-btn">
                        <i class="bi bi-chevron-left nav-icon"></i>
                        <div class="nav-content">
                            <div class="nav-label">Article précédent</div>
                            <div class="nav-title">{{ previousArticle.title }}</div>
                        </div>
                    </a>
                {% else %}
                    <div class="nav-btn disabled">
                        <i class="bi bi-chevron-left nav-icon"></i>
                        <div class="nav-content">
                            <div class="nav-label">Article précédent</div>
                            <div class="nav-title">Aucun article précédent</div>
                        </div>
                    </div>
                {% endif %}
                
                {% if nextArticle %}
                    <a href="{{ path('app_article_show', {'id': nextArticle.id}) }}" class="nav-btn">
                        <div class="nav-content">
                            <div class="nav-label">Article suivant</div>
                            <div class="nav-title">{{ nextArticle.title }}</div>
                        </div>
                        <i class="bi bi-chevron-right nav-icon"></i>
                    </a>
                {% else %}
                    <div class="nav-btn disabled">
                        <div class="nav-content">
                            <div class="nav-label">Article suivant</div>
                            <div class="nav-title">Aucun article suivant</div>
                        </div>
                        <i class="bi bi-chevron-right nav-icon"></i>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Article -->
        <div class="article-card">
            <!-- Article Header -->
            <div class="article-header">
                <div class="article-meta">
                    <div class="article-avatar">
                        {{ article.id }}
                    </div>
                    <div class="article-info">
                        <h1 class="article-title">{{ article.title }}</h1>
                        <div class="article-date">
                            {{ article.createdAt ? article.createdAt|date('d M Y à H:i') : 'Date inconnue' }}
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Article Content -->
            <div class="article-content">
                {{ article.content|nl2br }}
            </div>
            
            <!-- Categories -->
            {% if article.categories|length > 0 %}
                <div class="article-categories">
                    {% for category in article.categories %}
                        <span class="category-tag">{{ category.title }}</span>
                    {% endfor %}
                </div>
            {% endif %}
            
            <!-- Likes Info -->
            {% if article.likes|length > 0 %}
                <div class="likes-section">
                    <div class="likes-info">
                        <div class="like-icon-small">
                            <i class="bi bi-heart-fill"></i>
                        </div>
                        <span class="likes-count">{{ article.likes|length }}</span>
                        <span>{{ article.likes|length > 1 ? 'personnes aiment ceci' : 'personne aime ceci' }}</span>
                    </div>
                </div>
            {% endif %}
            
            <!-- Article Actions -->
            <div class="article-actions">
                <form method="post" action="{{ path('article_like', {'id': article.id}) }}" class="like-form" style="flex: 1; margin: 0;">
                    <button type="submit" class="action-btn like-btn {{ userLiked ? 'liked' : '' }}">
                        <i class="bi {{ userLiked ? 'bi-heart-fill' : 'bi-heart' }} like-icon"></i>
                        <span class="like-text">{{ userLiked ? 'Aimé' : 'J\'aime' }}</span>
                    </button>
                </form>
                <a href="{{ path('app_article_edit', {'id': article.id}) }}" class="action-btn">
                    <i class="bi bi-pencil"></i>
                    Modifier
                </a>
            </div>
        </div>

        <!-- Comments Section -->
        <div class="comments-section">
            <div class="comments-title">
                <i class="bi bi-chat-dots"></i>
                Commentaires ({{ article.comments|length }})
            </div>
            
            {% if article.comments|length > 0 %}
                {% for comment in article.comments %}
                    <div class="comment-item">
                        <div class="comment-author">{{ comment.author }}</div>
                        <div class="comment-content">{{ comment.content|nl2br }}</div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="no-comments">
                    <i class="bi bi-chat-square-text"></i>
                    <br>Aucun commentaire pour cet article.
                </div>
            {% endif %}
            
            <!-- Comment Form -->
            <div class="comment-form">
                <div class="comment-form-title">
                    <i class="bi bi-plus-circle"></i>
                    Ajouter un commentaire
                </div>
                {{ form_start(commentForm) }}
                    {{ form_widget(commentForm.content, {'attr': {'class': 'form-control', 'placeholder': 'Votre commentaire...', 'rows': 4}}) }}
                    <button type="submit" class="btn-comment">
                        <i class="bi bi-send"></i>
                        Publier le commentaire
                    </button>
                {{ form_end(commentForm) }}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Animation d'apparition
            const elements = document.querySelectorAll('.article-navigation, .article-card, .comments-section');
            elements.forEach((element, index) => {
                element.style.opacity = '0';
                element.style.transform = 'translateY(20px)';
                element.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                
                setTimeout(() => {
                    element.style.opacity = '1';
                    element.style.transform = 'translateY(0)';
                }, index * 150);
            });
            
            // Gestion du like
            const likeForm = document.querySelector('.like-form');
            if (likeForm) {
                likeForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    
                    const likeBtn = this.querySelector('.like-btn');
                    const likeIcon = likeBtn.querySelector('.like-icon');
                    const likeText = likeBtn.querySelector('.like-text');
                    
                    // Animation de loading
                    likeBtn.style.opacity = '0.6';
                    likeBtn.style.pointerEvents = 'none';
                    
                    // Envoi de la requête
                    fetch(this.action, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        }
                    })
                    .then(response => {
                        if (response.ok) {
                            // Toggle de l'état du like
                            const isLiked = likeBtn.classList.contains('liked');
                            
                            if (isLiked) {
                                likeBtn.classList.remove('liked');
                                likeIcon.className = 'bi bi-heart like-icon';
                                likeText.textContent = 'J\'aime';
                            } else {
                                likeBtn.classList.add('liked');
                                likeIcon.className = 'bi bi-heart-fill like-icon';
                                likeText.textContent = 'Aimé';
                                
                                // Animation de like
                                likeBtn.style.animation = 'likeAnimation 0.3s ease';
                                setTimeout(() => {
                                    likeBtn.style.animation = '';
                                }, 300);
                            }
                            
                            // Mettre à jour le compteur
                            const likesSection = document.querySelector('.likes-section');
                            const likesCount = likesSection ? likesSection.querySelector('.likes-count') : null;
                            
                            if (likesCount) {
                                const currentCount = parseInt(likesCount.textContent);
                                const newCount = isLiked ? currentCount - 1 : currentCount + 1;
                                likesCount.textContent = newCount;
                                
                                if (newCount === 0) {
                                    likesSection.style.display = 'none';
                                }
                            } else if (!isLiked) {
                                // Créer la section likes
                                const likesHtml = `
                                    <div class="likes-section">
                                        <div class="likes-info">
                                            <div class="like-icon-small">
                                                <i class="bi bi-heart-fill"></i>
                                            </div>
                                            <span class="likes-count">1</span>
                                            <span>personne aime ceci</span>
                                        </div>
                                    </div>
                                `;
                                const categoriesSection = document.querySelector('.article-categories');
                                const contentSection = document.querySelector('.article-content');
                                
                                if (categoriesSection) {
                                    categoriesSection.insertAdjacentHTML('afterend', likesHtml);
                                } else {
                                    contentSection.insertAdjacentHTML('afterend', likesHtml);
                                }
                            }
                        }
                    })
                    .catch(error => {
                        console.error('Erreur lors du like:', error);
                    })
                    .finally(() => {
                        likeBtn.style.opacity = '1';
                        likeBtn.style.pointerEvents = 'auto';
                    });
                });
            }
            
            // Auto-resize du textarea
            const textarea = document.querySelector('textarea');
            if (textarea) {
                textarea.addEventListener('input', function() {
                    this.style.height = 'auto';
                    this.style.height = this.scrollHeight + 'px';
                });
            }
        });
    </script>
{% endblock %}
